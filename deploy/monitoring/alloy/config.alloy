// Grafana Alloy — pipeline log lab IAM.
// Status: SEBAGIAN terisi (sumber Docker + parse Keycloak). Bagian bertanda
// TODO diselesaikan PESERTA di Sesi 4 (OpenBao, Warpgate).
// Log VM srv1/client1 (auth, audit, CIS) dikirim Alloy di VM masing-masing (lab/alloy/host.alloy).
//
// Prinsip label: label HANYA low-cardinality (service, event).
// user/ip DISIMPAN sebagai field di baris log, dikueri via `| json` di LogQL —
// JANGAN dijadikan label (ledakan kardinalitas).

// ---------- Sumber: seluruh log container Docker ----------
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// Ambil nama service compose sebagai label 'service'
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.containers.output
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.process.router.receiver]
}

// ---------- Router: arahkan per service ke pipeline yang sesuai ----------
loki.process "router" {
	// Keycloak: dengan KC_LOG_CONSOLE_OUTPUT=json, tiap baris adalah JSON dengan
	// data event BERADA DI DALAM field "message" (mis.
	//   message = "type=\"LOGIN\", realmId=\"..\", userId=\"..\", ipAddress=\"1.2.3.4\", .."),
	// BUKAN sebagai key JSON tingkat atas. Jadi: ambil message + loggerName,
	// saring logger event, lalu regex untuk type/ipAddress/userId.
	stage.match {
		selector = "{service=\"keycloak\"}"

		stage.json {
			expressions = { message = "message", logger = "loggerName" }
		}
		// Baris non-event tidak memuat 'type=' sehingga kc_type kosong (tak berlabel).
		// Catatan River: atribut block dipisah BARIS BARU, bukan koma.
		stage.regex {
			source     = "message"
			expression = "type=\"?(?P<kc_type>[A-Z_]+)"
		}
		stage.regex {
			source     = "message"
			expression = "ipAddress=\"?(?P<ipAddress>[0-9a-fA-F:.]+)"
		}
		stage.regex {
			source     = "message"
			expression = "userId=\"?(?P<userId>[0-9a-f-]+)"
		}
		stage.regex {
			source     = "message"
			expression = "error=\"?(?P<kc_error>[a-z_]+)"
		}
		// label hanya low-cardinality:
		stage.labels {
			values = { event = "kc_type" }
		}
		// user/ip/error sebagai structured metadata (bukan label):
		stage.structured_metadata {
			values = { user = "userId", ip = "ipAddress", error = "kc_error" }
		}
	}

	// TODO PESERTA (Sesi 4): tambahkan stage.match untuk service="openbao"
	//   parse JSON audit device → field request.path, auth.display_name, remote_address
	// stage.match { selector = "{service=\"openbao\"}" ... }

	// TODO PESERTA: service="warpgate" → login, buka sesi target, gagal auth

	// Samba AD DC (dc1): audit JSON di stdout container
	// (smb.conf: log level = 1 auth_json_audit:3 dsdb_group_json_audit:5).
	// Image lab memancarkan JSON MENTAH per baris, mis.
	//   {"timestamp":"..","type":"Authentication","Authentication":{..}}
	//   {"timestamp":"..","type":"groupChange","groupChange":{..}}
	// (bukan berprefiks "JSON Authentication:"). Saring baris audit berdasar field type.
	stage.match {
		selector = "{service=\"samba-dc\"}"

		// Baris audit berupa JSON mentah {"type":"Authentication"|"groupChange",...}.
		stage.json {
			expressions = {
				samba_type   = "type",
				auth_status  = "Authentication.status",
				auth_client  = "Authentication.clientAccount",
				auth_service = "Authentication.serviceDescription",
				grp_action   = "groupChange.action",
				grp_user     = "groupChange.user",
				grp_group    = "groupChange.group",
			}
		}
		// Line-filter pada selector stage.match TIDAK berfungsi di Alloy v1.5, jadi baris
		// non-audit disaring di sini: keep_flag "keep" hanya utk type audit → sisanya di-drop
		// (mencegah Loki penuh debug & label event="" kosong).
		stage.template {
			source   = "keep_flag"
			template = "{{ if or (eq .samba_type \"groupChange\") (eq .samba_type \"Authentication\") }}keep{{ end }}"
		}
		stage.drop {
			source              = "keep_flag"
			expression          = "^$"
			drop_counter_reason = "samba_non_audit"
		}
		// Nama akun pendek: "IAMLAB\dewi" / "dewi@IAMLAB.TEST" → "dewi"; groupChange.user = DN.
		stage.regex {
			source     = "auth_client"
			expression = "^(?:[^\\\\]*\\\\)?(?P<samba_user>[^@]+)"
		}
		stage.regex {
			source     = "grp_user"
			expression = "^CN=(?P<samba_user>[^,]+)"
		}
		stage.template {
			source   = "samba_event"
			template = "{{ if eq .samba_type \"groupChange\" }}group_change{{ else if eq .auth_status \"NT_STATUS_OK\" }}login_ok{{ else }}login_fail{{ end }}"
		}
		stage.template {
			source   = "samba_user"
			template = "{{ if .samba_user }}{{ ToLower .samba_user }}{{ end }}"
		}
		// Akun mesin (SRV1$, CLIENT1$) sering login → buang dari jejak pengguna.
		stage.drop {
			source              = "samba_user"
			expression          = ".*\\$$"
			drop_counter_reason = "samba_machine_account"
		}
		stage.labels {
			values = { event = "samba_event" }
		}
		stage.structured_metadata {
			values = { user = "samba_user", group = "grp_group", action = "grp_action", samba_service = "auth_service", status = "auth_status" }
		}
	}

	forward_to = [loki.write.default.receiver]
}

// ---------- Tujuan ----------
loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
