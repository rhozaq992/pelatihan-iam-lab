          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Timeline aktivitas user (login, logout, sudo, perintah)",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"host\", host=~\"$host\", user=~\"$user\", event=~\"login_ok|login_fail|logout|sudo|exec|identity_change\"}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Semua jejak user terpilih di srv1/client1, terbaru di atas. Buka detail baris untuk field ip/cmd/exe."
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Perintah sudo",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"host\", host=~\"$host\", user=~\"$user\", event=\"sudo\"} | line_format \"{{.host}} {{.user}} → {{.run_as}}: {{.cmd}}{{ if .sudo_denied }} [DITOLAK: {{.sudo_denied}}]{{ end }}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Dari /var/log/auth.log. run_as/cmd/sudo_denied = structured metadata."
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Perintah yang dijalankan (auditd execve)",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"host\", host=~\"$host\", user=~\"$user\", event=\"exec\"} | line_format \"{{.host}} {{.user}} $ {{.exe}} ({{.comm}})\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Aturan auditd key=user_cmd (lab/audit/iamlab.rules)."
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Login SSO Keycloak (user terpilih)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"keycloak\", event=~\"LOGIN|LOGIN_ERROR|LOGOUT\"} |~ \"(?i)${user:pipe}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Event Keycloak memuat username di pesan → disaring dengan line filter. Pilih satu/lebih user agar tersaring."
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Samba AD: autentikasi & perubahan grup",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"samba-dc\", event=~\"login_ok|login_fail|group_change\"} | user=~\"$user\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Dari container samba-dc (dc1). user/group/action = structured metadata. Alamat sumber = gateway Docker, bukan IP klien."
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Perubahan identitas lokal (passwd/group/sudoers/sssd)",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"host\", host=~\"$host\", user=~\"$user\", event=\"identity_change\"}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Skor CIS Benchmark terakhir per host (%)",
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (host) (last_over_time({job=\"host\", source=\"cis\"} | json | unwrap score [7d]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "belum ada scan",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Dari cis-scan.sh (OpenSCAP): srv1 = cis_level1_server, client1 = cis_level1_workstation. Bandingkan sebelum vs sesudah remediasi."
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Riwayat scan CIS",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"host\", source=\"cis\", host=~\"$host\"} | json | line_format \"{{.host}} {{.profile}}: skor {{.score}}% (pass {{.pass}}, fail {{.fail}}) → {{.report}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
