    {
      "id": 6,
      "type": "timeseries",
      "title": "Login sukses vs gagal per host",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({job=\"host\", host=~\"$host\", user=~\"$user\", event=\"login_ok\"} [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "sukses {{host}}"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({job=\"host\", host=~\"$host\", user=~\"$user\", event=\"login_fail\"} [$__interval]))",
          "refId": "B",
          "queryType": "range",
          "legendFormat": "gagal {{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Aktivitas per user (semua event)",
      "gridPos": {
        "x": 12,
        "y": 9,
