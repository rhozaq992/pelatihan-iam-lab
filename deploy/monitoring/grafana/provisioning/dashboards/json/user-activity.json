      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (user) (count_over_time({job=\"host\", host=~\"$host\", user=~\"$user\", event!=\"\"} [$__interval]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{user}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
