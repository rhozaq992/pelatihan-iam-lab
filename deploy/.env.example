# ====== Lab IAM — variabel lingkungan (salin ke .env) ======
# Domain lab (sintetis)
LAB_DOMAIN=iamlab.test

# IP VM Windows Server 2025 (DC) di jaringan Host-Only lab (VirtualBox/VMware).
# Stack Docker menghubungi DC lewat alamat ini (LDAPS/Kerberos/DNS).
DC_IP=10.10.10.10
DC_HOST=dc1.iamlab.test

# ---- Keycloak ----
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin#2026
KC_DB_PASSWORD=ChangeMe_KcDb#2026

# ---- App-Komentar (diisi SETELAH peserta membuat client OIDC di Keycloak) ----
APP_OIDC_CLIENT_ID=app-komentar
APP_OIDC_CLIENT_SECRET=ISI_SETELAH_BUAT_CLIENT
APP_FLASK_SECRET=ganti-string-acak-panjang

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=ChangeMe_Grafana#2026

# ---- Locust (Sesi 4 capstone) ----
LAB_PROFILE=normal
LAB_TEST_USER=
LAB_TEST_PASS=

# ---- Catatan ----
# Rahasia di atas HANYA untuk lab terisolasi. Jangan dipakai di produksi.
# File .env TIDAK di-commit (lihat .gitignore).

# Samba AD DC (Sesi 1 Bagian A) — sandi Administrator domain IAMLAB.TEST
SAMBA_ADMIN_PASS=Passw0rd#Lab2026
