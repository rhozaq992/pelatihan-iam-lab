## Aturan auditd lab IAM (srv1, client1) → /etc/audit/rules.d/iamlab.rules
## Dipungut Alloy (lab/alloy/host.alloy) sebagai source="audit".
## Pasang: sudo cp iamlab.rules /etc/audit/rules.d/ && sudo augenrules --load

## Perintah yang dijalankan pengguna login (auid = akun yang login, tetap walau sudo/su)
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=unset -k user_cmd
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=unset -k user_cmd

## Perubahan identitas & hak istimewa lokal
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k identity
-w /etc/sudoers.d/ -p wa -k identity

## Konfigurasi join domain (sssd, Kerberos)
-w /etc/sssd/ -p wa -k identity
-w /etc/krb5.conf -p wa -k identity
