// Grafana Alloy — agen log di VM Ubuntu lab (srv1, client1).
// Dipasang di /etc/alloy/config.alloy saat build (build-lab.ps1).
//
// Mengirim aktivitas pengguna ke Loki di host Docker (10.10.10.5:3100) dengan label:
//   job="host", host=<srv1|client1>, source=<auth|audit|cis>,
//   event=<login_ok|login_fail|logout|sudo|exec|identity_change|cis_scan>,
//   user=<nama pendek, huruf kecil>  (hanya pada event aktivitas pengguna)
// Nilai berkardinalitas tinggi (ip, exe, cmd, layanan PAM) → structured metadata.
//
// Kompromi lab: 'user' dijadikan label agar bisa di-discover sebagai variabel dashboard
// (populasi terbatas ±220 akun). Di produksi berskala besar simpan sebagai structured metadata.
// Log Samba AD (dc1) dipungut Alloy container di host Docker, bukan di sini.

// ---------- Sumber berkas ----------
local.file_match "auth" {
	path_targets = [{"__path__" = "/var/log/auth.log", "job" = "host", "host" = constants.hostname, "source" = "auth"}]
}

local.file_match "audit" {
	path_targets = [{"__path__" = "/var/log/audit/audit.log", "job" = "host", "host" = constants.hostname, "source" = "audit"}]
}

local.file_match "cis" {
	path_targets = [{"__path__" = "/var/log/cis/summary.log", "job" = "host", "host" = constants.hostname, "source" = "cis"}]
}

// host → nama pendek huruf kecil (mis. "SRV1.iamlab.test" → "srv1")
discovery.relabel "hostname" {
	targets = array.concat(
		local.file_match.auth.targets,
		local.file_match.audit.targets,
		local.file_match.cis.targets,
	)

	rule {
		source_labels = ["host"]
		regex         = "([^.]+).*"
		replacement   = "$1"
		target_label  = "host"
	}
	rule {
		source_labels = ["host"]
		target_label  = "host"
		action        = "lowercase"
	}
}

loki.source.file "host" {
	targets    = discovery.relabel.hostname.output
	forward_to = [loki.process.host.receiver]
}

// ---------- Parsing ----------
// Nama akun domain bisa muncul sebagai "dewi.puspita001", "dewi.puspita001@iamlab.test"
// atau "IAMLAB\dewi.puspita001" → regex di bawah selalu menangkap nama pendeknya saja.
loki.process "host" {

	// ===== auth.log (sshd, PAM/sssd, gdm, sudo) =====
	// Buang baris yang bukan aktivitas login/sudo (cron, systemd-logind, dsb.).
	stage.match {
		selector            = "{source=\"auth\"} !~ \"Accepted |Failed (password|publickey|none) for |authentication failure|session (opened|closed) for user|sudo:\""
		action              = "drop"
		drop_counter_reason = "auth_noise"
	}

	// SSH berhasil: "sshd[812]: Accepted password for dewi.puspita001 from 10.10.10.5 port 5555 ssh2"
	stage.match {
		selector = "{source=\"auth\"} |~ \"sshd.*Accepted \""

		stage.regex {
			expression = "Accepted (?P<method>\\S+) for (?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^@\\s]+)(?:@\\S+)? from (?P<ip>\\S+)"
		}
		stage.static_labels {
			values = { event = "login_ok" }
		}
	}

	// SSH gagal: "Failed password for [invalid user] x from 10.10.10.5 port .."
	stage.match {
		selector = "{source=\"auth\"} |~ \"sshd.*Failed (password|publickey|none) for \""

		stage.regex {
			expression = "Failed (?P<method>\\S+) for (?:invalid user )?(?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^@\\s]+)(?:@\\S+)? from (?P<ip>\\S+)"
		}
		stage.static_labels {
			values = { event = "login_fail" }
		}
	}

	// PAM gagal (gdm/login/su/sudo lewat pam_sss/pam_unix):
	// "pam_sss(gdm-password:auth): authentication failure; logname= uid=0 euid=0 tty=/dev/tty1 ruser= rhost= user=dewi.puspita001"
	stage.match {
		selector = "{source=\"auth\"} |~ \"pam_(sss|unix)\\\\([^:]+:auth\\\\): authentication failure\""

		stage.regex {
			expression = "pam_\\w+\\((?P<pam_service>[^:]+):auth\\): authentication failure;.*\\buser=(?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^@\\s]+)"
		}
		stage.regex {
			expression = "rhost=(?P<ip>[^\\s]+)"
		}
		// Gagal SSH sudah tercatat dari baris "Failed password" → hindari hitung ganda.
		stage.drop {
			source              = "pam_service"
			value               = "sshd"
			drop_counter_reason = "auth_dup_sshd"
		}
		stage.static_labels {
			values = { event = "login_fail" }
		}
	}

	// Login interaktif desktop/konsol (ssh sudah tercatat dari 'Accepted'):
	// "pam_unix(gdm-password:session): session opened for user dewi.puspita001(uid=1234) by (uid=0)"
	stage.match {
		selector = "{source=\"auth\"} |~ \"\\\\((gdm-password|gdm-autologin|login):session\\\\): session opened for user\""

		stage.regex {
			expression = "\\((?P<pam_service>[^:]+):session\\): session opened for user (?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^@\\s(]+)"
		}
		stage.static_labels {
			values = { event = "login_ok" }
		}
	}

	// Logout (ssh, desktop, konsol)
	stage.match {
		selector = "{source=\"auth\"} |~ \"\\\\((sshd|gdm-password|gdm-autologin|login):session\\\\): session closed for user\""

		stage.regex {
			expression = "\\((?P<pam_service>[^:]+):session\\): session closed for user (?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^@\\s(]+)"
		}
		stage.static_labels {
			values = { event = "logout" }
		}
	}

	// sudo: "sudo: dewi.puspita001 : TTY=pts/0 ; PWD=/home/dewi.puspita001 ; USER=root ; COMMAND=/usr/bin/apt update"
	//       (penolakan: "sudo: x : user NOT in sudoers ; TTY=.. ; USER=root ; COMMAND=..")
	stage.match {
		selector = "{source=\"auth\"} |~ \"sudo:\\\\s+\\\\S+ : \""

		stage.regex {
			expression = "sudo:\\s+(?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^@\\s]+)(?:@\\S+)? : .*?USER=(?P<run_as>\\S+) ; COMMAND=(?P<cmd>.*)$"
		}
		stage.regex {
			expression = " : (?P<sudo_denied>user NOT in sudoers|[^;]*incorrect password attempts?)"
		}
		stage.static_labels {
			values = { event = "sudo" }
		}
	}

	// Sisa baris auth yang tak terklasifikasi (mis. session opened untuk sudo/cron/sshd) → buang.
	stage.match {
		selector            = "{source=\"auth\", event=\"\"}"
		action              = "drop"
		drop_counter_reason = "auth_unclassified"
	}

	// ===== auditd (log_format = ENRICHED; aturan lab/audit/iamlab.rules) =====
	// Simpan hanya rekaman SYSCALL berkunci user_cmd / identity.
	stage.match {
		selector            = "{source=\"audit\"} !~ \"type=SYSCALL.*key=\\\"(user_cmd|identity)\\\"\""
		action              = "drop"
		drop_counter_reason = "audit_noise"
	}

	stage.match {
		selector = "{source=\"audit\"}"

		// Bagian ENRICHED: AUID="dewi.puspita001" ; bagian mentah: comm="ls" exe="/usr/bin/ls" key="user_cmd"
		stage.regex {
			expression = "AUID=\"(?:[Ii][Aa][Mm][Ll][Aa][Bb]\\\\)?(?P<u>[^\"@]+)"
		}
		stage.regex {
			expression = "comm=\"(?P<comm>[^\"]*)\" exe=\"(?P<exe>[^\"]*)\""
		}
		stage.regex {
			expression = "key=\"(?P<audit_key>[^\"]+)\""
		}
		// proses tanpa sesi login (auid tak terdefinisi) → buang
		stage.drop {
			source              = "u"
			value               = "unset"
			drop_counter_reason = "audit_unset_auid"
		}
		stage.template {
			source   = "audit_event"
			template = "{{ if eq .audit_key \"user_cmd\" }}exec{{ else }}identity_change{{ end }}"
		}
		stage.labels {
			values = { event = "audit_event" }
		}
	}

	// ===== CIS (cis-scan.sh → /var/log/cis/summary.log, satu baris JSON per scan) =====
	// Skor dibaca saat kueri: {source="cis"} | json | unwrap score
	stage.match {
		selector = "{source=\"cis\"}"

		stage.json {
			expressions = { cis_profile = "profile" }
		}
		stage.static_labels {
			values = { event = "cis_scan" }
		}
		stage.structured_metadata {
			values = { profile = "cis_profile" }
		}
	}

	// ===== Normalisasi user + metadata (semua sumber) =====
	stage.template {
		source   = "u"
		template = "{{ if .u }}{{ ToLower .u }}{{ end }}"
	}
	stage.labels {
		values = { user = "u" }
	}
	stage.structured_metadata {
		values = {
			ip          = "ip",
			method      = "method",
			pam_service = "pam_service",
			cmd         = "cmd",
			run_as      = "run_as",
			sudo_denied = "sudo_denied",
			exe         = "exe",
			comm        = "comm",
		}
	}

	forward_to = [loki.write.lab.receiver]
}

// ---------- Tujuan: Loki di host Docker ----------
loki.write "lab" {
	endpoint {
		url = "http://10.10.10.5:3100/loki/api/v1/push"
	}
}
